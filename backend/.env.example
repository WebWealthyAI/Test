# Server
PORT=4000
NODE_ENV=development

# Wenn leer -> Backend läuft im MOCK-Modus (In-Memory Store, kein externer Dienst nötig)

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Connect
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Plattform-Gebühr in Prozent (Treuhand-Provision von Tradelater)
PLATFORM_FEE_PERCENT=7

# Auth
JWT_SECRET=dev-secret-change-me
