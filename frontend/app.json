{
  "expo": {
    "name": "Tradelater",
    "slug": "tradelater",
    "scheme": "tradelater",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ch.tradelater.app"
    },
    "android": {
      "package": "ch.tradelater.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-image-picker"]
  }
}
