# URL der Backend-API (Expo macht EXPO_PUBLIC_* im Client verfügbar)
EXPO_PUBLIC_API_URL=http://localhost:4000/api

# Supabase (optional – für direkte Realtime-Subscriptions)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Stripe Publishable Key (für @stripe/stripe-react-native)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
